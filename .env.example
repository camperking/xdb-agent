# Vorlage für .env — kopieren und ausfüllen: cp .env.example .env
# Die echte .env ist in .gitignore und gehört nicht ins Repository.

# OpenAI-kompatibles Gateway für die Unterhaltung.
# rig 0.46 hängt den Pfad (/chat/completions) direkt an diese Basis-URL,
# das /v1 muss also Teil des Wertes sein.
OPENAI_API_KEY=
OPENAI_BASE_URL=http://localhost:8080/v1

# Ollama für die Einbettungen des dynamischen Kontexts.
OLLAMA_API_BASE_URL=http://localhost:11434
